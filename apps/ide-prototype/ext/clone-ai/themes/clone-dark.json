    "titleBar.activeBackground": "#141414", "titleBar.inactiveBackground": "#141414", "titleBar.border": "#ffffff0d",
    "statusBar.background": "#141414", "statusBar.foreground": "#9a9a9a", "statusBar.border": "#ffffff0d", "statusBar.noFolderBackground": "#141414",
    "panel.background": "#141414", "panel.border": "#ffffff14",
