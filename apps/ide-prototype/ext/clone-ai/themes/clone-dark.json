    "list.activeSelectionBackground": "#ffffff1e", "list.hoverBackground": "#ffffff0d", "list.inactiveSelectionBackground": "#ffffff14", "list.activeSelectionForeground": "#ffffff",
    "input.background": "#ffffff0a", "input.border": "#ffffff1a", "focusBorder": "#81a1c1aa",
    "button.background": "#81a1c1", "button.foreground": "#101418", "button.hoverBackground": "#94b1cc",
    "textLink.foreground": "#81a1c1", "badge.background": "#81a1c1", "badge.foreground": "#101418",
    "diffEditor.insertedLineBackground": "#3fb95026", "diffEditor.removedLineBackground": "#f8514926",
    "editorWidget.background": "#1c1c1c", "dropdown.background": "#1c1c1c", "menu.background": "#1c1c1c", "quickInput.background": "#1c1c1c",
    "scrollbarSlider.background": "#ffffff14", "scrollbarSlider.hoverBackground": "#ffffff26",
