  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#6b7280", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#a3be8c" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#d08770" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#81a1c1" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#88c0d0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#ebcb8b" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#d8dee9" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#9aa0a6" } }
