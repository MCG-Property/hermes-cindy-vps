    "tab.activeBackground": "#fcfcfc", "tab.inactiveBackground": "#f3f3f3", "editorGroupHeader.tabsBackground": "#f3f3f3",
    "button.background": "#2778c1", "button.foreground": "#ffffff", "focusBorder": "#2778c188", "textLink.foreground": "#0064b0",
